{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug lru_cache_test (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/lru_cache_test",
            // eg: "args": ["--gtest_filter=CopyCtorAndAssignment.CopyAssignmentClearOriginalData"], 
            // e.g. ["--gtest_filter=IntLruCacheEdge.*"]
            "args": [],
            "cwd": "${workspaceFolder}/build",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "stopAtEntry": false,
            "externalConsole": false,
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "cmake-build-debug"
        }
    ]
}